<Window x:Class="ScrcpyControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scrcpy 控制台"
        Width="1320"
        Height="840"
        MinWidth="1100"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="6"
                            Background="{StaticResource AccentDarkBrush}">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Scrcpy 控制台"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText"
                                   Text="检测中"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DeviceComboBox"
                              Grid.Column="0"
                              Margin="0,10,20,10"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="DeviceComboBox_SelectionChanged"
                              ToolTip="自动检测到的 ADB 设备" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot"
                                     Width="9"
                                     Height="9"
                                     Fill="{StaticResource MutedBrush}"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="ConnectionStatusText"
                                       Text="正在检测设备"
                                       MaxWidth="245"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="设备状态每 2 秒自动刷新"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   Margin="17,2,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ScreenToggleButton"
                            Style="{StaticResource IconButton}"
                            Content="&#xE708;"
                            Margin="0,10,8,10"
                            Click="ScreenToggle_Click"
                            IsEnabled="False"
                            ToolTip="熄灭手机屏幕（保持投屏）" />

                    <Button x:Name="StartStopButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="启动 scrcpy"
                            MinWidth="122"
                            Margin="0,10,0,10"
                            Click="StartStop_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#191D22"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="0,14,0,10">
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,10">
                        <TextBlock Text="scrcpy 5.0.1"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="便携控制中心"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="DashboardNav"
                                     Style="{StaticResource NavButton}"
                                     IsChecked="True"
                                     Tag="Dashboard"
                                     Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="控制台" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ParametersNav"
                                     Style="{StaticResource NavButton}"
                                     Tag="Parameters"
                                     Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="参数设置" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FilesNav"
                                     Style="{StaticResource NavButton}"
                                     Tag="Files"
                                     Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="文件管理" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LogsNav"
                                     Style="{StaticResource NavButton}"
                                     Tag="Logs"
                                     Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="运行日志" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SettingsNav"
                                     Style="{StaticResource NavButton}"
                                     Tag="Settings"
                                     Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22,18,22,16">
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="控制台" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="设备、投屏、亮度和运行状态集中在这里。"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,-6,0,14" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource PanelBorder}"
                            Padding="8"
                            Margin="0,0,0,12">
                        <UniformGrid x:Name="PhoneControlBar"
                                     Columns="10"
                                     IsEnabled="False">
                            <Button x:Name="PhoneBackButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="back"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="返回上一级 / Back">
                                <StackPanel>
                                    <TextBlock Text="&#xE72B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="返回"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhoneHomeButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="home"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="返回主屏幕 / Home">
                                <StackPanel>
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="主屏幕"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhoneRecentButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="recent"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="打开最近任务 / Recent apps">
                                <StackPanel>
                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="最近任务"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhoneMenuButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="menu"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="打开菜单 / Menu">
                                <StackPanel>
                                    <TextBlock Text="&#xE700;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="菜单"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhoneVolumeDownButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="volume_down"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="降低音量 / Volume down">
                                <StackPanel>
                                    <TextBlock Text="－"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="音量减"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhoneVolumeUpButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="volume_up"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="提高音量 / Volume up">
                                <StackPanel>
                                    <TextBlock Text="＋"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="音量加"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhonePowerButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Tag="power"
                                    Click="PhoneKeyControl_Click"
                                    ToolTip="按下电源键 / Power">
                                <StackPanel>
                                    <TextBlock Text="&#xE7E8;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="电源"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ControlScreenToggleButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Click="ScreenToggle_Click"
                                    ToolTip="熄灭手机屏幕（保持投屏）">
                                <StackPanel>
                                    <TextBlock x:Name="ControlScreenToggleIcon"
                                               Text="&#xE708;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ControlScreenToggleText"
                                               Text="熄灭屏幕"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScreenshotGalleryButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Click="ScreenshotGallery_Click"
                                    ToolTip="截取当前屏幕并保存到手机相册">
                                <StackPanel>
                                    <TextBlock Text="&#xE722;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="系统截屏"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScreenshotClipboardButton"
                                    Style="{StaticResource DeviceControlButton}"
                                    Click="ScreenshotClipboard_Click"
                                    ToolTip="截取当前屏幕并复制到 Windows 剪贴板">
                                <StackPanel>
                                    <TextBlock Text="&#xE77F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="截屏到电脑"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="设备状态"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14" />
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="设备" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="DeviceModelText"
                                               Grid.Column="1"
                                               Text="—" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="系统" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="DeviceSystemText"
                                               Grid.Column="1"
                                               Text="—" />
                                </Grid>
                                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                                    <TextBlock Text="启动命令"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="CommandPreviewBox"
                                             FontFamily="Cascadia Mono"
                                             FontSize="12"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="90" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="快捷操作"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14" />
                                <Button x:Name="DashboardStartButton"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8"
                                        Click="StartStop_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DashboardStartIcon"
                                                   Text="&#xE768;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DashboardStartText"
                                                   Text="启动 scrcpy"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickScreenButton"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8"
                                        Click="ScreenToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE708;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="熄灭 / 点亮手机屏幕"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalContentAlignment="Left"
                                        Click="OpenFilesPage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="打开文件管理"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Margin="0,16,0,0"
                                        Padding="12"
                                        Background="#15191E"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="智能亮度"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5" />
                                        <TextBlock x:Name="IdleStatusText"
                                                   Text="投屏启动后生效"
                                                   Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="最近日志"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="  ·  scrcpy 控制台窗口保持独立"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="RecentLogBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,0"
                                     FontFamily="Cascadia Mono"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ParametersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="参数设置 / Parameters" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="scrcpy 5.0.1 的 109 个参数，中文翻译与英文原文同时显示。 / All 109 scrcpy options with Chinese translations and original English text."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,-6,0,12" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource PanelBorder}"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,10,0" Height="36">
                                <TextBox x:Name="OptionSearchBox"
                                         Height="36"
                                         Padding="32,6,10,6"
                                         TextChanged="OptionSearch_TextChanged"
                                         ToolTip="搜索参数名、说明或 CLI 参数 / Search names, descriptions or CLI options" />
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="11,0,0,0"
                                           IsHitTestVisible="False" />
                                <TextBlock Text="搜索参数名、中文说明或 CLI 参数"
                                           VerticalAlignment="Center"
                                           Margin="34,0,10,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=OptionSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ComboBox x:Name="CategoryComboBox"
                                      Grid.Column="1"
                                      Height="36"
                                      Margin="0,0,10,0"
                                      SelectionChanged="CategoryComboBox_SelectionChanged" />

                            <Border Grid.Column="2"
                                    Height="36"
                                    Background="#15191E"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,0">
                                <CheckBox x:Name="ModifiedOnlyCheckBox"
                                          Content="只看已修改 / Modified only"
                                          VerticalAlignment="Center"
                                          Checked="ModifiedOnly_Changed"
                                          Unchecked="ModifiedOnly_Changed" />
                            </Border>

                            <DockPanel Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="配置操作"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="  ·  修改后可保存为独立配置"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="加载配置 / Load"
                                            Height="34"
                                            Click="LoadProfile_Click" />
                                    <Button Content="保存配置 / Save"
                                            Height="34"
                                            Margin="8,0,0,0"
                                            Click="SaveProfile_Click" />
                                    <Button Content="恢复默认 / Reset"
                                            Height="34"
                                            Margin="8,0,0,0"
                                            Click="ResetOptions_Click" />
                                    <Button x:Name="RunActionButton"
                                            Content="工具动作 / Actions"
                                            Height="34"
                                            Margin="8,0,0,0"
                                            Click="RunAction_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="0">
                        <ScrollViewer x:Name="ParameterScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ParameterPanel" Margin="16" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="额外原始参数 / Extra arguments"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,6" />
                            <TextBox x:Name="ExtraArgumentsBox"
                                     Grid.Row="1"
                                     FontFamily="Cascadia Mono"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextChanged="ExtraArguments_TextChanged"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="追加到 scrcpy 命令末尾的原始参数" />
                        </Grid>
                        <Border Grid.Column="2"
                                Style="{StaticResource PanelBorder}"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="已修改参数 / Modified"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="ModifiedCountText"
                                           Text="0 项"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="原始参数会原样追加，请自行确认冲突。"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="FilesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="文件管理" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="浏览手机目录并上传或下载文件，不提供删除与重命名。"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,-6,0,12" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE72B;"
                                ToolTip="返回上级目录"
                                Click="BrowseRemoteUp_Click" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Content="&#xE72C;"
                                Margin="6,0,0,0"
                                ToolTip="刷新目录"
                                Click="RefreshFiles_Click" />
                        <TextBox x:Name="RemotePathBox"
                                 Grid.Column="2"
                                 Margin="8,0"
                                 FontFamily="Cascadia Mono"
                                 KeyDown="RemotePathBox_KeyDown" />
                        <Button Grid.Column="3"
                                Content="上传文件"
                                Click="UploadFiles_Click" />
                        <Button Grid.Column="4"
                                Content="下载所选"
                                Margin="8,0,0,0"
                                Click="DownloadSelected_Click" />
                        <Button Grid.Column="5"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8A5;"
                                Margin="8,0,0,0"
                                ToolTip="转到 /sdcard"
                                Click="GoSdcard_Click" />
                    </Grid>

                    <ListView x:Name="FileListView"
                              Grid.Row="2"
                              SelectionMode="Extended"
                              MouseDoubleClick="FileList_MouseDoubleClick"
                              PreviewKeyDown="FileList_PreviewKeyDown"
                              AllowDrop="True"
                              DragOver="FileList_DragOver"
                              Drop="FileList_Drop">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DataListItemStyle}">
                                <Setter Property="ToolTip" Value="{Binding FullPath}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制文件名 / Copy names"
                                          Click="CopyFileNames_Click" />
                                <MenuItem Header="复制完整路径 / Copy full paths"
                                          Click="CopyFilePaths_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="310" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="类型" Width="75" DisplayMemberBinding="{Binding KindLabel}" />
                                <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeLabel}" />
                                <GridViewColumn Header="修改时间" Width="155" DisplayMemberBinding="{Binding Modified}" />
                                <GridViewColumn Header="权限" Width="110" DisplayMemberBinding="{Binding Permissions}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="传输队列"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="TransferStatusText"
                                           Text="  空闲"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ListView x:Name="TransferListView"
                                      Grid.Row="1"
                                      Margin="0,8,0,8"
                                      Height="62"
                                      PreviewKeyDown="TransferList_PreviewKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DataListItemStyle}">
                                        <Setter Property="ToolTip" Value="{Binding RemotePath}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制传输信息 / Copy transfer details"
                                                  Click="CopyTransferDetails_Click" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="方向" Width="55" DisplayMemberBinding="{Binding DirectionLabel}" />
                                        <GridViewColumn Header="文件" Width="300" DisplayMemberBinding="{Binding DisplayName}" />
                                        <GridViewColumn Header="状态" Width="280" DisplayMemberBinding="{Binding Status}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="TransferProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             VerticalAlignment="Center" />
                                <Button x:Name="CancelTransferButton"
                                        Grid.Column="1"
                                        Content="取消"
                                        Margin="10,0,0,0"
                                        IsEnabled="False"
                                        Click="CancelTransfer_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="scrcpy、ADB 与控制器输出会写入这里。"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,-6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="保存日志" Click="SaveLog_Click" />
                            <Button Content="清空" Margin="8,0,0,0" Click="ClearLog_Click" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                        <TextBox x:Name="FullLogBox"
                                 FontFamily="Cascadia Mono"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="设置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="控制便携配置、亮度行为及工具路径状态。"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,-6,0,12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="投屏与亮度"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,14" />
                                    <CheckBox x:Name="AutoStayAwakeCheckBox"
                                              Content="默认添加 --stay-awake，防止手机锁屏"
                                              Margin="0,0,0,12" />
                                    <CheckBox x:Name="IdleDimCheckBox"
                                              Content="仅监控 scrcpy 窗口内的键盘、点击、滚轮和拖动"
                                              Margin="0,0,0,12" />
                                    <CheckBox x:Name="ClickToInputCheckBox"
                                              Content="点击手机输入框时启用透明中文输入宿主 / Enable transparent IME host on field click"
                                              Margin="0,0,0,12" />
                                    <CheckBox x:Name="AutoSubmitCheckBox"
                                              Content="停止输入后自动发送 / Auto-submit when typing stops"
                                              Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自动发送防抖时间" VerticalAlignment="Center" />
                                        <TextBox x:Name="AutoSubmitDebounceBox" Grid.Column="1" />
                                        <TextBlock Grid.Column="2"
                                                   Text="毫秒"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="默认 100 毫秒，可设置 50–5000 毫秒。"
                                               Style="{StaticResource MutedText}"
                                               Margin="210,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="无操作后降低亮度" VerticalAlignment="Center" />
                                        <TextBox x:Name="IdleSecondsBox" Grid.Column="1" />
                                        <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="目标亮度" VerticalAlignment="Center" />
                                        <TextBox x:Name="DimBrightnessBox" Grid.Column="1" />
                                        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="亮度采用 Android 0–255 范围；10% 约等于 26。"
                                               Style="{StaticResource MutedText}"
                                               Margin="210,8,0,0" />
                                    <Button Content="保存设置"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,16,0,0"
                                            Click="SaveSettings_Click" />
                                    <Button Content="测试透明输入宿主 / Test input host"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="TestInputSink_Click" />
                                    <TextBlock Text="自动识别失败时，可按 Ctrl+Alt+F12 在鼠标位置强制打开输入宿主。 / Press Ctrl+Alt+F12 if automatic field detection fails."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="工具与数据路径"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="scrcpy 工具目录"
                                               Style="{StaticResource MutedText}" />
                                    <TextBox x:Name="ScrcpyDirectoryBox"
                                             IsReadOnly="True"
                                             FontFamily="Cascadia Mono"
                                             Margin="0,5,0,12" />
                                    <TextBlock Text="配置与日志目录"
                                               Style="{StaticResource MutedText}" />
                                    <TextBox x:Name="DataDirectoryBox"
                                             IsReadOnly="True"
                                             FontFamily="Cascadia Mono"
                                             Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#111418"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatusText"
                           Text="就绪"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="USB 有线连接 · 独立 scrcpy 窗口"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
